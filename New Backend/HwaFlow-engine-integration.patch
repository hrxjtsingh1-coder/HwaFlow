diff --git a/app/api/engine/jobs/route.ts b/app/api/engine/jobs/route.ts
new file mode 100644
index 0000000..0de7fbb
--- /dev/null
+++ b/app/api/engine/jobs/route.ts
@@ -0,0 +1,149 @@
+/**
+ * POST /api/engine/jobs — start an image-cleaning + typesetting run for a chapter.
+ *
+ * Reads the originals from Supabase Storage (where your dropzone already puts
+ * them), forwards them to the Engine Bridge Worker, and returns a job id.
+ * The browser never sees the engine URL or its token.
+ */
+
+import { requirePipelineViewer } from "@/lib/pipeline-auth";
+import { createClient } from "@/lib/supabase/server";
+import { createEngineJob } from "@/lib/engine";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+export const maxDuration = 300;
+
+const isUuid = (value: unknown): value is string =>
+  typeof value === "string" &&
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value);
+
+/** HwaFlow uses ko/ja/zh; the engine's OCR loader uses ko/ja/zh-Hans. */
+function engineSourceLang(value: unknown): string {
+  if (value === "zh") return "zh-Hans";
+  if (value === "ko" || value === "ja") return value;
+  return "auto";
+}
+
+export async function POST(request: Request) {
+  const auth = await requirePipelineViewer();
+  if (!auth.ok) return auth.response;
+
+  let body: { chapterId?: unknown };
+  try {
+    body = (await request.json()) as { chapterId?: unknown };
+  } catch {
+    return Response.json({ error: "invalid-request", message: "Expected a JSON body." }, { status: 400 });
+  }
+  if (!isUuid(body.chapterId)) {
+    return Response.json({ error: "invalid-request", message: "A valid chapterId is required." }, { status: 400 });
+  }
+
+  const supabase = await createClient();
+
+  // RLS scopes this to chapters the viewer can see. Also gives us the series
+  // id (for glossary) and the source language (for OCR).
+  const { data: chapter, error: chapterError } = await supabase
+    .from("chapters")
+    .select("id, series_id")
+    .eq("id", body.chapterId)
+    .maybeSingle();
+  if (chapterError || !chapter) {
+    return Response.json({ error: "not-found", message: "That chapter was not found." }, { status: 404 });
+  }
+
+  const { data: series } = await supabase
+    .from("series")
+    .select("source_language")
+    .eq("id", chapter.series_id)
+    .maybeSingle();
+
+  const { data: glossaryRows } = await supabase
+    .from("glossary_terms")
+    .select("source_term, target_term, category")
+    .eq("series_id", chapter.series_id)
+    .eq("status", "active")
+    .limit(500);
+
+  const { data: pageRows, error: pageError } = await supabase
+    .from("chapter_pages")
+    .select("id, page_index, original_path, storage_state")
+    .eq("chapter_id", body.chapterId)
+    .order("page_index", { ascending: true });
+  if (pageError) {
+    return Response.json({ error: "storage", message: "Couldn't read this chapter's pages." }, { status: 500 });
+  }
+
+  // HwaFlow already ran Gemini extract -> translate -> proofread and keeps the
+  // approved English text here. Ship it with the images so a Kaggle kernel
+  // with NO internet can still typeset real translations (see kaggle/).
+  const { data: blockRows } = await supabase
+    .from("text_blocks")
+    .select("page_id, block_index, source_text, base_translation, final_text")
+    .eq("chapter_id", body.chapterId)
+    .order("block_index", { ascending: true });
+
+  const stored = (pageRows || []).filter((row) => row.storage_state === "stored");
+  if (stored.length === 0) {
+    return Response.json(
+      { error: "no-pages", message: "This chapter has no original images left to process." },
+      { status: 409 }
+    );
+  }
+
+  try {
+    const pages: Array<{ blob: Blob; mimeType: string }> = [];
+    for (const row of stored) {
+      const { data: blob, error } = await supabase.storage.from("pages").download(row.original_path);
+      if (error || !blob) {
+        return Response.json(
+          { error: "storage", message: `Couldn't read page ${row.page_index + 1}. Re-upload it and retry.` },
+          { status: 502 }
+        );
+      }
+      pages.push({ blob, mimeType: blob.type || "image/webp" });
+    }
+
+    // HwaFlow categories -> the engine CLI's TermDraft categories.
+    const categoryMap: Record<string, string> = {
+      character: "character",
+      place: "location",
+      honorific: "title",
+      item: "item",
+      term: "concept",
+    };
+    const glossary = (glossaryRows || []).map((term) => ({
+      sourceTerm: term.source_term,
+      targetTerm: term.target_term,
+      category: categoryMap[term.category] || "other",
+    }));
+
+    // Align translations to the SAME page order as `pages` (stored, sorted by
+    // page_index). XianScan numbers pages 001, 002, ... in that order.
+    const blocksByPage = new Map<string, Array<{ text: string }>>();
+    for (const block of blockRows || []) {
+      const text = (block.final_text || block.base_translation || "").trim();
+      if (!text) continue;
+      const list = blocksByPage.get(block.page_id) || [];
+      list.push({ text });
+      blocksByPage.set(block.page_id, list);
+    }
+    const translations = stored.map(
+      (row) => (blocksByPage.get(row.id) || []).map((b) => b.text)
+    );
+
+    const job = await createEngineJob({
+      chapterId: body.chapterId,
+      pages,
+      sourceLang: engineSourceLang(series?.source_language),
+      targetLang: "en",
+      glossary,
+      translations,
+    });
+
+    return Response.json(job, { status: 201, headers: { "Cache-Control": "no-store" } });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "Unknown engine error.";
+    return Response.json({ error: "engine", message }, { status: 502 });
+  }
+}
diff --git a/components/chapters/engine-panel.tsx b/components/chapters/engine-panel.tsx
new file mode 100644
index 0000000..bbd41d0
--- /dev/null
+++ b/components/chapters/engine-panel.tsx
@@ -0,0 +1,294 @@
+"use client";
+
+/**
+ * Drop-in panel for the chapter workspace: run the image engine, watch it,
+ * compare before/after, approve (which purges the raws), or reject.
+ *
+ * Self-contained: inline styles, no new dependencies, no CSS file needed.
+ * Mount it anywhere inside the workspace view with:
+ *
+ *   <EnginePanel chapterId={chapter.id} canApprove={canManage} />
+ */
+
+import { useCallback, useEffect, useRef, useState, type CSSProperties } from "react";
+
+type EnginePage = { index: number; status: string };
+type EngineJob = {
+  jobId: string;
+  status: "pending" | "working" | "done" | "failed" | "approved" | "rejected";
+  pageCount: number;
+  pages: EnginePage[];
+  error: string | null;
+  finishedAt: string | null;
+  approvedAt: string | null;
+  urls: Array<{ index: number; raw: string; final: string; approved: string; regions: string }>;
+};
+
+type Props = {
+  chapterId: string;
+  /** Owner/Manager only, matching the rest of HwaFlow's approval flow. */
+  canApprove?: boolean;
+  /** Optional: let the parent move the chapter to `ready`/`approved` too. */
+  onApproved?: (jobId: string) => void | Promise<void>;
+};
+
+const S = {
+  box: {
+    border: "1px solid var(--border, rgba(127,127,127,.28))",
+    borderRadius: 14,
+    padding: 16,
+    margin: "16px 0",
+    background: "var(--surface, rgba(127,127,127,.05))",
+    color: "var(--text, inherit)",
+    fontFamily: "inherit",
+  } as CSSProperties,
+  row: { display: "flex", gap: 10, alignItems: "center", flexWrap: "wrap" } as CSSProperties,
+  title: { margin: 0, fontSize: 14, fontWeight: 650, letterSpacing: ".01em" } as CSSProperties,
+  sub: { margin: "4px 0 0", fontSize: 12, opacity: 0.7 } as CSSProperties,
+  button: {
+    border: "1px solid rgba(127,127,127,.35)",
+    borderRadius: 9,
+    padding: "8px 13px",
+    font: "inherit",
+    fontSize: 13,
+    cursor: "pointer",
+    background: "transparent",
+    color: "inherit",
+  } as CSSProperties,
+  primary: {
+    border: "1px solid transparent",
+    borderRadius: 9,
+    padding: "8px 13px",
+    font: "inherit",
+    fontSize: 13,
+    fontWeight: 600,
+    cursor: "pointer",
+    background: "#6c5ce7",
+    color: "white",
+  } as CSSProperties,
+  chip: {
+    display: "inline-block",
+    padding: "3px 9px",
+    borderRadius: 999,
+    fontSize: 11,
+    fontWeight: 600,
+    background: "rgba(108,92,231,.14)",
+    color: "#6c5ce7",
+  } as CSSProperties,
+  compare: { display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginTop: 14 } as CSSProperties,
+  figure: { margin: 0, minWidth: 0 } as CSSProperties,
+  img: {
+    width: "100%",
+    maxHeight: 360,
+    objectFit: "contain",
+    borderRadius: 10,
+    border: "1px solid rgba(127,127,127,.25)",
+    background: "rgba(127,127,127,.08)",
+  } as CSSProperties,
+  caption: { fontSize: 11, opacity: 0.7, marginTop: 5 } as CSSProperties,
+  error: { color: "#d64545", fontSize: 12, marginTop: 10 } as CSSProperties,
+};
+
+const STATUS_COPY: Record<EngineJob["status"], string> = {
+  pending: "Queued — waiting for the engine to pick it up",
+  working: "Engine is cleaning and typesetting the pages",
+  done: "Ready for review",
+  failed: "The engine could not finish this run",
+  approved: "Approved — raws deleted, finals kept for 7 days",
+  rejected: "Discarded",
+};
+
+export function EnginePanel({ chapterId, canApprove = true, onApproved }: Props) {
+  const storageKey = `hwaflow.engineJob.${chapterId}`;
+  const [jobId, setJobId] = useState<string | null>(null);
+  const [job, setJob] = useState<EngineJob | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [pageIndex, setPageIndex] = useState(0);
+  const timer = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  const readJob = useCallback(async (id: string) => {
+    try {
+      const response = await fetch(`/api/engine/jobs/${id}`, { cache: "no-store" });
+      if (!response.ok) throw new Error((await response.json()).message || "Could not read the job.");
+      const next = (await response.json()) as EngineJob;
+      setJob(next);
+      return next;
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Could not read the job.");
+      return null;
+    }
+  }, []);
+
+  useEffect(() => {
+    const saved = typeof window !== "undefined" ? localStorage.getItem(storageKey) : null;
+    if (saved) {
+      setJobId(saved);
+      void readJob(saved);
+    }
+    return () => { if (timer.current) clearInterval(timer.current); };
+  }, [storageKey, readJob]);
+
+  // Poll only while the engine is still working. Stops on terminal states.
+  useEffect(() => {
+    if (timer.current) { clearInterval(timer.current); timer.current = null; }
+    if (!jobId || !job || !["pending", "working"].includes(job.status)) return;
+    timer.current = setInterval(() => void readJob(jobId), 2500);
+    return () => { if (timer.current) clearInterval(timer.current); };
+  }, [jobId, job?.status, readJob]);
+
+  async function run() {
+    setBusy(true);
+    setError(null);
+    try {
+      const response = await fetch("/api/engine/jobs", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ chapterId }),
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.message || "Could not start the image engine.");
+      localStorage.setItem(storageKey, data.jobId);
+      setJobId(data.jobId);
+      setPageIndex(0);
+      await readJob(data.jobId);
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Could not start the image engine.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function decide(kind: "approve" | "reject") {
+    if (!jobId) return;
+    setBusy(true);
+    setError(null);
+    try {
+      const response = await fetch(`/api/engine/jobs/${jobId}/${kind}`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: "{}",
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.message || "Could not update the job.");
+      setJob(data);
+      if (kind === "reject") {
+        localStorage.removeItem(storageKey);
+        setJobId(null);
+        setJob(null);
+      } else {
+        await onApproved?.(jobId);
+      }
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Could not update the job.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const active = job && ["pending", "working"].includes(job.status);
+  const urls = job?.urls ?? [];
+  const current = urls[Math.min(pageIndex, Math.max(0, urls.length - 1))];
+
+  return (
+    <section style={S.box} aria-label="Image engine">
+      <div style={{ ...S.row, justifyContent: "space-between" }}>
+        <div>
+          <h3 style={S.title}>Image engine</h3>
+          <p style={S.sub}>
+            Detect → erase → translate → typeset. Your originals are deleted the moment you approve.
+          </p>
+        </div>
+        {job ? <span style={S.chip}>{job.status.toUpperCase()}</span> : null}
+      </div>
+
+      <div style={{ ...S.row, marginTop: 12 }}>
+        <button type="button" style={S.primary} onClick={run} disabled={busy || Boolean(active)}>
+          {busy ? "Working…" : job ? "Run again" : "Run image engine"}
+        </button>
+        {job ? (
+          <button type="button" style={S.button} onClick={() => void readJob(job.jobId)} disabled={busy}>
+            Refresh
+          </button>
+        ) : null}
+        {job?.status === "done" && canApprove ? (
+          <button type="button" style={S.button} onClick={() => void decide("approve")} disabled={busy}>
+            ✓ Approve & clean up
+          </button>
+        ) : null}
+        {job && job.status !== "approved" ? (
+          <button type="button" style={S.button} onClick={() => void decide("reject")} disabled={busy}>
+            Discard
+          </button>
+        ) : null}
+      </div>
+
+      {job ? <p style={S.sub}>{STATUS_COPY[job.status]}</p> : null}
+      {job?.error ? <p style={S.error}>{job.error}</p> : null}
+      {error ? <p style={S.error}>{error}</p> : null}
+
+      {job?.status === "pending" ? (
+        <p style={S.sub}>
+          The engine polls the queue. If nothing happens for a few minutes, the Kaggle/Colab notebook
+          is probably sleeping — start it once and this will pick up automatically.
+        </p>
+      ) : null}
+
+      {current && ["done", "approved"].includes(job?.status || "") ? (
+        <>
+          <div style={{ ...S.row, marginTop: 12, justifyContent: "space-between" }}>
+            <span style={S.sub}>Page {current.index + 1} of {urls.length}</span>
+            <div style={S.row}>
+              <button
+                type="button"
+                style={S.button}
+                disabled={pageIndex === 0}
+                onClick={() => setPageIndex((value) => Math.max(0, value - 1))}
+              >
+                ← Prev
+              </button>
+              <button
+                type="button"
+                style={S.button}
+                disabled={pageIndex >= urls.length - 1}
+                onClick={() => setPageIndex((value) => Math.min(urls.length - 1, value + 1))}
+              >
+                Next →
+              </button>
+            </div>
+          </div>
+          <div style={S.compare}>
+            <figure style={S.figure}>
+              <img style={S.img} src={current.raw} alt="Original page" />
+              <figcaption style={S.caption}>Original (deleted on approval)</figcaption>
+            </figure>
+            <figure style={S.figure}>
+              <img
+                style={S.img}
+                src={job?.status === "approved"
+                  ? `/api/engine/jobs/${job.jobId}/approved/${current.index}`
+                  : current.final}
+                alt="Cleaned and typeset page"
+              />
+              <figcaption style={S.caption}>Cleaned + typeset</figcaption>
+            </figure>
+          </div>
+          <div style={{ ...S.row, marginTop: 10 }}>
+            {urls.map((page) => (
+              <a
+                key={page.index}
+                style={{ ...S.button, textDecoration: "none" }}
+                href={job?.status === "approved"
+                  ? `/api/engine/jobs/${job.jobId}/approved/${page.index}`
+                  : page.final}
+                download={`page-${String(page.index + 1).padStart(3, "0")}.png`}
+              >
+                ↓ Page {page.index + 1}
+              </a>
+            ))}
+          </div>
+        </>
+      ) : null}
+    </section>
+  );
+}
