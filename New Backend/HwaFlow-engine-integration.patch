@@ -0,0 +1,41 @@
+/**
+ * GET /api/engine/jobs/:id/:kind/:page
+ *
+ * Streams raw / final / approved / clean images and regions JSON from the
+ * Engine Bridge Worker. The engine token stays server-side.
+ */
+
+import { getViewer } from "@/lib/session";
+import { proxyEngineAsset } from "@/lib/engine";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+type Kind = "raw" | "final" | "approved" | "clean" | "regions";
+const KINDS: Kind[] = ["raw", "final", "approved", "clean", "regions"];
+
+export async function GET(
+  _request: Request,
+  { params }: { params: Promise<{ id: string; kind: string; page: string }> }
+) {
+  // Assets are polled/rendered many times per chapter, so use the cheap
+  // session check here instead of the pipeline rate limiter.
+  const viewer = await getViewer();
+  if (!viewer) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id, kind, page } = await params;
+  if (!KINDS.includes(kind as Kind) || !/^\d+$/.test(page)) {
+    return Response.json({ error: "invalid-request" }, { status: 400 });
+  }
+
+  try {
+    return await proxyEngineAsset(id, kind as Kind, Number(page));
+  } catch (error) {
+    return Response.json(
+      { error: "engine", message: error instanceof Error ? error.message : "Unknown engine error." },
+      { status: 502 }
+    );
+  }
+}
diff --git a/app/api/engine/jobs/[id]/approve/route.ts b/app/api/engine/jobs/[id]/approve/route.ts
new file mode 100644
index 0000000..4a39cd6
--- /dev/null
+++ b/app/api/engine/jobs/[id]/approve/route.ts
@@ -0,0 +1,99 @@
+/**
+ * POST /api/engine/jobs/:id/approve
+ *
+ * This is the "Approve" click. It copies the final PNGs into the 7-day bucket
+ * and deletes the engine's raw uploads + all intermediate images immediately.
+ *
+ * If ENGINE_PURGE_SUPABASE_ORIGINALS=1, it ALSO deletes the user's original
+ * WebPs from the Supabase `pages` bucket and marks those rows purged — closing
+ * the loop on the "raw must not survive approval" requirement.
+ *
+ * Add an Owner/Manager role check here if only managers should approve — the
+ * rest of HwaFlow uses `canManage` from @/lib/series for that. (The SQL RPC
+ * below already refuses non-managers.)
+ */
+
+import { requirePipelineViewer } from "@/lib/pipeline-auth";
+import { createClient } from "@/lib/supabase/server";
+import { approveEngineJob, getEngineJob } from "@/lib/engine";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function POST(_request: Request, { params }: { params: Promise<{ id: string }> }) {
+  const auth = await requirePipelineViewer();
+  if (!auth.ok) return auth.response;
+
+  const { id } = await params;
+  try {
+    // Server-side Owner/Manager check. The purge RPC below enforces this too,
+    // but a direct URL to this route must not bypass it. If the optional
+    // migration has not been applied the RPC errors and we fail open (the
+    // existing pipeline behaviour), logging a warning instead of blocking.
+    try {
+      const guardClient = await createClient();
+      const preview = await getEngineJob(id);
+      if (preview.chapterId) {
+        const { data: allowed, error: roleError } = await guardClient.rpc(
+          "can_manage_chapter",
+          { p_chapter: preview.chapterId }
+        );
+        if (!roleError && allowed === false) {
+          return Response.json(
+            { error: "forbidden", message: "Only a manager can approve engine results." },
+            { status: 403, headers: { "Cache-Control": "no-store" } }
+          );
+        }
+        if (roleError) console.warn("[engine] manager check skipped:", roleError.message);
+      }
+    } catch (cause) {
+      console.warn("[engine] manager check unavailable:", cause);
+    }
+
+    const job = await approveEngineJob(id);
+
+    // Best-effort: engine approval already succeeded, so a purge failure must
+    // never turn this into an error response.
+    if (process.env.ENGINE_PURGE_SUPABASE_ORIGINALS === "1" && job.chapterId) {
+      try {
+        const supabase = await createClient();
+        const { data: pageRows } = await supabase
+          .from("chapter_pages")
+          .select("original_path")
+          .eq("chapter_id", job.chapterId)
+          .eq("storage_state", "stored");
+
+        const paths = (pageRows || [])
+          .map((row) => row.original_path)
+          .filter((path): path is string => typeof path === "string" && path.length > 0);
+
+        // The RPC checks permissions + the group's retention_policy first.
+        // Only delete objects if it actually purged rows.
+        const { data: purged, error: purgeError } = await supabase.rpc(
+          "purge_chapter_originals",
+          { p_chapter: job.chapterId }
+        );
+
+        if (!purgeError && Number(purged) > 0 && paths.length > 0) {
+          const { error: removeError } = await supabase.storage.from("pages").remove(paths);
+          if (removeError) {
+            console.warn(`[engine] originals marked purged but Storage delete failed: ${removeError.message}`);
+          }
+        } else if (purgeError) {
+          // Most likely the optional migration has not been applied yet, or
+          // the caller is not a manager. Engine approval still stands.
+          console.warn(`[engine] Supabase purge skipped: ${purgeError.message}`);
+        }
+      } catch (cause) {
+        console.warn("[engine] Supabase purge skipped:", cause);
+      }
+    }
+
+    return Response.json(job, { headers: { "Cache-Control": "no-store" } });
+  } catch (error) {
+    return Response.json(
+      { error: "engine", message: error instanceof Error ? error.message : "Unknown engine error." },
+      { status: 502 }
+    );
+  }
+}
