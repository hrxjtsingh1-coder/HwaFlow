# Non-secret defaults for the image engine. OpenNext Cloudflare bundles .env*
# into the Worker, so these are available at runtime without dashboard clicks.
# The SECRET (ENGINE_WEB_TOKEN) is intentionally NOT here — it must be added
# as an encrypted Secret in the Cloudflare dashboard.
ENGINE_API_URL=https://engine.hwaflow.space
ENGINE_PURGE_SUPABASE_ORIGINALS=0
ENGINE_STRICT_ACCESS=0
ENGINE_HEALTH_DEBUG=1
