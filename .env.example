# HwaFlow pipeline configuration
#
# Copy this file to .env.local and fill in the key. `.env.local` is gitignored;
# this example never contains a secret.

# Google AI Studio key for the free tier.
# Create one at https://aistudio.google.com/apikey — no credit card required.
# Free quota is per project (500 requests/day on gemini-3.5-flash-lite), so
# extra keys in the same project gain nothing. Do not build key rotation.
GEMINI_API_KEY=

# Set to 1 to short-circuit all three pipeline routes with deterministic fake
# bubbles, boxes and terms. No network call, no quota spent. Use this while
# building or testing the workspace UI.
MOCK_PIPELINE=0
