# HwaFlow configuration
#
# Copy this file to .env.local and fill in the values. `.env.local` is
# gitignored; this example never contains a secret.

# ---------------------------------------------------------------------------
# Supabase (required for auth, groups, chapters, storage)
# Copy from the dashboard's Connect dialog, then restart the dev server.
# Confirm the server pair with /api/health/supabase.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix either of these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# XianScan image engine bridge — server-only, never NEXT_PUBLIC_
# HwaFlow sends original page images and the series glossary to XianScan.
# XianScan's Gemini provider credentials stay configured on the engine side.
# ---------------------------------------------------------------------------
ENGINE_API_URL=
ENGINE_WEB_TOKEN=
ENGINE_PURGE_SUPABASE_ORIGINALS=0

# Optional: fail CLOSED when chapter access cannot be positively verified.
# Default (empty/0) keeps the panel usable during a transient Supabase error.
# Set to 1 once supabase db push is done and you want strict isolation.
ENGINE_STRICT_ACCESS=

# Optional: allow a detailed health report in production, but ONLY when called
# with ?verbose=1 and an x-engine-debug header equal to ENGINE_WEB_TOKEN.
# Safe to leave on; without both, /api/health/engine still returns just {ok}.
ENGINE_HEALTH_DEBUG=
