# HwaFlow pipeline configuration
#
# Copy this file to .env.local and fill in the key. `.env.local` is gitignored;
# this example never contains a secret.

# Google AI Studio key for the free tier.
# Create one at https://aistudio.google.com/apikey — no credit card required.
# Free quota is per project (500 requests/day on gemini-3.5-flash-lite), so
# extra keys in the same project gain nothing. Do not build key rotation.
GEMINI_API_KEY=

# Set to 1 to short-circuit all three pipeline routes with deterministic fake
# bubbles, boxes and terms. No network call, no quota spent. Use this while
# building or testing the workspace UI.
MOCK_PIPELINE=0

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Copy these from the dashboard's Connect dialog (or Settings > API Keys), then
# restart the dev server — .env.local is only read at startup.
#
# Names matter. `anon` and `service_role` are the legacy keys, deprecated by the
# end of 2026; their replacements are `sb_publishable_` and `sb_secret_`.
# A publishable key is safe to ship to the browser: RLS is the real boundary.
# A secret key is not — Supabase also rejects it from a browser with a 401.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix either of these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: how the health check proves both keys work.
# GET /api/health/supabase after filling the four values above.
